# Builder Base V2 — environment variables (NAMES ONLY — no values here).
# Copy to `.env` for local development and set real values there / in Vercel.
# NEVER commit real values. All variables are read at BUILD time on the
# server; none reach the browser.

# ── Content source ───────────────────────────────────────────────────
# local (default) = typed records in src/data/local, no network
# baserow         = the Builder Base Baserow database (see docs/content/baserow.md)
CONTENT_SOURCE=
# true = fail the build instead of falling back when Baserow is unavailable (default false)
CONTENT_STRICT=

# ── Baserow (Builder Base database only — never the WITH CLAUDE tables) ─
# Default https://api.baserow.io
BASEROW_API_URL=
# Read-only database token scoped to the Builder Base tables. Never a setup/admin credential.
BASEROW_DATABASE_TOKEN=
# Table IDs — listed in docs/content/baserow.md. Photos is required when CONTENT_SOURCE=baserow.
BASEROW_TABLE_PHOTOS=
BASEROW_TABLE_CITIES=
BASEROW_TABLE_ORGANIZATIONS=
BASEROW_TABLE_RELATIONSHIPS=
BASEROW_TABLE_ACTIVATIONS=
BASEROW_TABLE_PROJECTS=
BASEROW_TABLE_BUILDERS=
BASEROW_TABLE_TEAM=

# ── Photo delivery ───────────────────────────────────────────────────
# Comma-separated HTTPS hostnames that serve remote photo masters
# (object storage / CDN). Needed only for photos stored by "Asset URL".
PHOTO_ASSET_HOSTS=

# ── Luma ─────────────────────────────────────────────────────────────
# Public API key for the Builder Base calendar (requires Luma Plus).
# Without it the site links to https://luma.com/Builderbase instead.
LUMA_API_KEY=

# ── Development only ─────────────────────────────────────────────────
# ECOSYSTEM_FIXTURE=1 with `astro dev` renders /ecosystem from FICTIONAL
# organisations (src/data/fixtures). Ignored by production builds. Never set it
# in Vercel.

# Schema setup (scripts/baserow-setup.mjs) uses a separate, temporary,
# git-ignored `.env.setup` — never these variables, never the website.
