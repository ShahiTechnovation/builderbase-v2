---
/**
 * Option B — "Statement over the room".
 *
 * Desktop/tablet: statement on paper, photograph directly beneath.
 * Mobile (<640px): photograph → statement → actions.
 *
 * The <h1> always reads "The distribution layer for builders." The anchor
 * word is uppercased with CSS so assistive tech reads it as a normal word.
 *
 * Motion (only with `:root.motion`, see src/styles/motion.css):
 *  - ENTRANCE: lines rise out of their masks in reading order; actions settle.
 *  - EXPAND + HANDOFF (≥640px): the photo frame is full-bleed in layout but
 *    clipped to the Option B inset; scrolling opens it to the edges and down
 *    to the culture section while a near-black shade rises to meet it.
 *  - DEPTH (≥640px): the photo drifts ±2% inside its frame.
 * Without motion the static Option B composition is shown, unchanged.
 */
import type { ResolvedPhoto } from '../data/model';
import { actions } from '../data/site';
import ActionLink from './ActionLink.astro';
import ShutterText from './ShutterText.astro';

interface Props {
	statement: { lead: string; anchor: string; tail: string };
	/** Small factual metadata beside "The". Only passed when the truth gate allows it. */
	meta?: string;
	photo?: ResolvedPhoto;
}

const { statement, meta, photo } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__statement page-width">
		<h1 class="statement" id="hero-title">
			<span class="statement__lead reveal-mask" data-entrance="mask" style="--i: 0"
				><span class="reveal-mask__line">{statement.lead}</span></span
			>{' '}
			<span class="statement__anchor" data-entrance="shutter" style="--i: 1">
				<ShutterText text={statement.anchor} />
			</span>{' '}
			<span class="statement__tail reveal-mask" data-entrance="mask" style="--i: 2"
				><span class="reveal-mask__line">{statement.tail}</span></span
			>
		</h1>
		{
			meta && (
				<p class="hero__meta meta" data-entrance="meta" style="--i: 2">
					{meta}
				</p>
			)
		}
		<div class="hero__actions" data-entrance="meta" style="--i: 3">
			<ActionLink link={actions.join} variant="primary" class="hero__join" />
			<ActionLink link={actions.partner} />
		</div>
	</div>

	<div class="hero__photo page-width">
		<div class="hero__frame" data-scroll="start through">
			<div class="hero__image" data-entrance="photo" style="--i: 1; position: relative; overflow: hidden; width: 100%; height: 100%;">
				<video
					src="https://k0zc4ww8smbcswkz.public.blob.vercel-storage.com/builder-base-hero.mp4"
					autoplay
					loop
					muted
					playsinline
					style="position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; transform: translate(-50%, -50%); border: none; pointer-events: none; object-fit: cover;"
				></video>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		--hero-gap: clamp(3.5rem, 2.8rem + 2vw, 4rem); /* paper between photo and culture */
		--frame-ratio: 1.6;

		display: flex;
		flex-direction: column;
		padding-bottom: var(--hero-gap);
	}

	/* ── Statement ─────────────────────────────────────────────────── */
	.hero__statement {
		container-type: inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		padding-inline: var(--gutter);
		padding-top: var(--space-5);
	}

	.statement {
		grid-column: 1 / -1;
		grid-row: 1 / span 3;
		display: grid;
		grid-template-columns: subgrid;
		grid-template-rows: subgrid;
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}

	.statement__lead,
	.statement__tail {
		font-size: var(--text-lead);
		letter-spacing: var(--tracking-lead);
		line-height: var(--leading-tight);
	}

	.statement__lead {
		grid-row: 1;
		grid-column: 1 / -1;
	}

	/* Sized against the statement's own width so the word always spans the
	   measure exactly: 100cqi ÷ (word width at 1px). Never wraps. */
	.statement__anchor {
		grid-row: 2;
		grid-column: 1 / -1;
		margin-inline-start: -0.035em; /* optical: pull the D's side bearing onto the gutter */
		font-size: 12.5vw;
		font-size: calc(100cqi / 7.27); /* Schibsted Grotesk 800 @ -0.055em: "DISTRIBUTION" ≈ 7.25em */
		font-weight: var(--weight-display);
		letter-spacing: var(--tracking-anchor);
		line-height: var(--leading-anchor);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.statement__tail {
		grid-row: 3;
		grid-column: 1;
	}

	.hero__meta {
		grid-row: 1;
		grid-column: -2 / -1;
		justify-self: end;
		align-self: center;
		color: var(--color-text-muted);
	}

	.hero__actions {
		grid-row: 4;
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	/* ── Photograph ────────────────────────────────────────────────── */
	.hero__photo {
		order: -1; /* mobile: photograph first */
	}

	.hero__frame {
		position: relative;
		height: min(112vw, 56svh);
		overflow: hidden;
		background-color: var(--color-well);
	}

	.hero__image {
		height: 100%;
	}

	.hero__frame :global(img) {
		object-position: var(--focal-portrait);
	}

	/* Soft bottom vignette — atmosphere, not decoration. */
	.hero__frame::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 24%;
		background: linear-gradient(to top, rgb(14 15 19 / 0.32), transparent);
		pointer-events: none;
	}

	/* ── Tablet: statement first, photograph beneath ───────────────── */
	@media (min-width: 40rem) {
		.hero__photo {
			order: 0;
			margin-top: var(--space-7);
			padding-inline: var(--gutter-photo);
		}

		.hero__statement {
			padding-top: var(--space-4);
		}

		.hero__frame {
			height: auto;
			aspect-ratio: var(--frame-ratio);
			border-radius: var(--radius-frame);
		}

		.hero__frame :global(img) {
			object-position: var(--focal);
		}

		.hero__meta {
			align-self: end;
			padding-bottom: 0.4em;
		}

		.hero__actions {
			flex-direction: row;
			align-items: center;
			gap: var(--space-5);
			margin-top: var(--space-6);
		}
	}

	/* ── Desktop: actions sit beside "layer for builders." ─────────── */
	@media (min-width: 64rem) {
		.hero {
			--frame-ratio: 2.175; /* 87 / 40 */
		}

		.hero__statement {
			grid-template-columns: max-content minmax(0, 1fr);
			column-gap: var(--space-7);
		}

		.hero__actions {
			grid-row: 3;
			grid-column: 2;
			align-self: center;
			margin-top: 0.15em;
		}
	}

	/* ── Motion: EXPAND + HANDOFF + DEPTH (≥640px) ─────────────────────
	   Layout never changes while scrolling: the frame is laid out full-bleed
	   (plus the paper gap) and only its clip, shade and image transform move.
	   At --scroll-start: 0 it is pixel-identical to the static composition. */
	@media (min-width: 40rem) {
		:global(:root.motion) .hero:not(.hero--no-photo) {
			padding-bottom: 0;
		}

		:global(:root.motion) .hero__photo {
			container-type: inline-size;
			padding-inline: 0;
		}

		:global(:root.motion) .hero__frame {
			--inset: var(--gutter-photo);
			--open: var(--scroll-start);
			--shut: calc(1 - var(--open));

			aspect-ratio: auto;
			height: calc((100cqi - 2 * var(--inset)) / var(--frame-ratio) + var(--hero-gap));
			border-radius: 0;
			clip-path: inset(
				0 calc(var(--inset) * var(--shut)) calc(var(--hero-gap) * var(--shut)) calc(var(--inset) * var(--shut))
					round calc(var(--radius-frame) * var(--shut))
			);
		}

		/* Vignette and handoff shade follow the visible bottom edge. */
		:global(:root.motion) .hero__frame::after,
		:global(:root.motion) .hero__frame::before {
			translate: 0 calc(-1 * var(--hero-gap) * var(--shut));
		}

		/* HANDOFF: near-black rises from the culture section into the photo. */
		:global(:root.motion) .hero__frame::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 1;
			background: linear-gradient(to top, var(--near-black) 0%, rgb(14 15 19 / 0.5) 50%, rgb(14 15 19 / 0) 100%);
			opacity: calc(var(--open) * var(--open) * var(--open));
			pointer-events: none;
		}

		/* DEPTH -> ENTER THE ROOM: the photograph zooms in massively as it opens. */
		:global(:root.motion) .hero__frame :global(img) {
			scale: calc(1 + (var(--open) * 0.4));
			transform-origin: center calc(50% + (var(--scroll-through) - 0.5) * 10%);
		}
	}
</style>
