---
/**
 * Builder Base Premium Opening Sequence — Signature Brand Film
 *
 * VOID -> BB MATERIALIZES -> TRANSITION TO NAVBAR
 */
import { monogram } from '../data/brand';
---

<div id="opening-sequence" class="opening" aria-hidden="true">
	<div class="opening__camera" id="opening-camera">
		<!-- Assembly Fragments -->
		<div class="opening__assembly" id="opening-assembly">
			<div class="opening__fragment opening__fragment--1"><svg viewBox={monogram.viewBox}><use href={`#${monogram.id}`}></use></svg></div>
			<div class="opening__fragment opening__fragment--2"><svg viewBox={monogram.viewBox}><use href={`#${monogram.id}`}></use></svg></div>
			<div class="opening__fragment opening__fragment--3"><svg viewBox={monogram.viewBox}><use href={`#${monogram.id}`}></use></svg></div>
			<div class="opening__fragment opening__fragment--4"><svg viewBox={monogram.viewBox}><use href={`#${monogram.id}`}></use></svg></div>
		</div>

		<!-- Solid BB that becomes the header handoff -->
		<div class="opening__solid-bb" id="opening-solid-bb">
			<svg viewBox={monogram.viewBox}><use href={`#${monogram.id}`}></use></svg>
		</div>
	</div>
	
	<!-- Meta Text -->
	<div class="opening__meta" id="opening-meta">
		<p>BUILDER BASE</p>
		<p class="opening__meta-sub">INITIALIZING DISTRIBUTION</p>
	</div>
</div>

<script>
	const root = document.documentElement;
	const sequence = document.getElementById('opening-sequence');
	
	if (sequence) {
		const assembly = document.getElementById('opening-assembly')!;
		const fragments = Array.from(document.querySelectorAll('.opening__fragment')) as HTMLElement[];
		const solidBb = document.getElementById('opening-solid-bb')!;
		const meta = document.getElementById('opening-meta')!;
		
		const STORAGE_KEY = 'bb_v2_signature_intro_played';
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const forceReplay = window.location.search.includes('replay-intro');
		
		let hasPlayed = false;
		try { hasPlayed = sessionStorage.getItem(STORAGE_KEY) === 'true'; } catch { /* ignore */ }

		let activeAnimations: Animation[] = [];
		const animate = (el: HTMLElement, keyframes: Keyframe[], options: KeyframeAnimationOptions) => {
			const anim = el.animate(keyframes, options);
			activeAnimations.push(anim);
			return anim;
		};

		const finishIntro = () => {
			activeAnimations.forEach(a => { try { a.finish(); } catch { /* ignore */ } });
			activeAnimations = [];
			root.classList.remove('intro-active');
			root.classList.add('intro-complete');
			sequence.style.opacity = '0';
			sequence.style.pointerEvents = 'none';
			setTimeout(() => sequence.remove(), 600);
		};

		const play = async () => {
			// Find final targets
			await new Promise(r => requestAnimationFrame(r));
			const targetBrand = document.querySelector('[data-opening-brand-target]');
			if (!targetBrand) return finishIntro();
			
			const cx = window.innerWidth / 2;
			const cy = window.innerHeight / 2;

			// BEAT 01: VOID META (0-1200ms)
			animate(meta, [
				{ opacity: 0, transform: 'translateY(10px)' },
				{ opacity: 1, transform: 'translateY(0)', offset: 0.2 },
				{ opacity: 1, transform: 'translateY(0)', offset: 0.8 },
				{ opacity: 0, transform: 'translateY(-10px)' }
			], { duration: 1600, easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)' });

			// BEAT 02: BB MATERIALIZES (1200-2000ms)
			fragments.forEach((frag, i) => {
				const z = (i % 2 === 0 ? 1 : -1) * (i + 1) * 80;
				const rotateX = i % 2 === 0 ? 60 : -60;
				animate(frag, [
					{ transform: `translate3d(0, ${z}px, ${z}px) rotateX(${rotateX}deg)`, opacity: 0, filter: 'blur(10px)' },
					{ transform: 'translate3d(0, 0, 0) rotateX(0deg)', opacity: 1, filter: 'blur(0px)' }
				], { duration: 900, delay: 1000 + (i * 60), easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)', fill: 'forwards' });
			});

			animate(assembly, [
				{ opacity: 1 }, { opacity: 0 }
			], { duration: 400, delay: 2200, fill: 'forwards' });

			// Swap to Solid BB
			animate(solidBb, [
				{ opacity: 0, transform: 'scale(1)' },
				{ opacity: 1, transform: 'scale(1)' }
			], { duration: 0, delay: 2200, fill: 'forwards' });

			// BEAT 03: MOVE TO NAVBAR
			// Fade out black background so page is visible during move
			animate(sequence, [
				{ backgroundColor: '#000' },
				{ backgroundColor: 'transparent' }
			], { duration: 600, delay: 2400, fill: 'forwards' });

			const brandRect = targetBrand.getBoundingClientRect();
			const destX = brandRect.left + brandRect.width/2 - cx;
			const destY = brandRect.top + brandRect.height/2 - cy;
			
			const moveBb = animate(solidBb, [
				{ opacity: 1, transform: `translate(0px, 0px) scale(1)` },
				{ opacity: 1, transform: `translate(${destX}px, ${destY}px) scale(${brandRect.width / 120})` }
			], { duration: 900, delay: 2400, easing: 'cubic-bezier(0.7, 0, 0.2, 1)', fill: 'forwards' });

			await moveBb.finished;
			finishIntro();
		};

		if (!prefersReducedMotion && (!hasPlayed || forceReplay)) {
			root.classList.add('intro-active');
			try { sessionStorage.setItem(STORAGE_KEY, 'true'); } catch { /* ignore */ }
			play().catch(finishIntro);
			
			// Interruption
			const interrupt = () => finishIntro();
			window.addEventListener('keydown', interrupt, { once: true });
			window.addEventListener('wheel', interrupt, { once: true });
			window.addEventListener('click', interrupt, { once: true });
		} else {
			finishIntro();
		}
	}
</script>

<style>
	.opening {
		position: fixed;
		inset: 0;
		z-index: 10000;
		overflow: hidden;
		background: #000;
	}

	:global(html:not(.intro-active)) .opening {
		display: none !important;
	}

	.opening__camera {
		position: absolute;
		inset: 0;
		perspective: 1000px;
		transform-style: preserve-3d;
		pointer-events: none;
	}

	.opening__assembly {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transform-style: preserve-3d;
	}

	.opening__fragment {
		position: absolute;
		width: clamp(5rem, 15vw, 8rem);
		height: clamp(5rem, 15vw, 8rem);
		color: var(--paper);
		opacity: 0;
		will-change: transform, opacity, filter;
	}

	.opening__fragment svg { width: 100%; height: 100%; fill: currentColor; }
	.opening__fragment--1 { clip-path: polygon(0 0, 50% 0, 50% 50%, 0 50%); }
	.opening__fragment--2 { clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); }
	.opening__fragment--3 { clip-path: polygon(0 50%, 50% 50%, 50% 100%, 0 100%); }
	.opening__fragment--4 { clip-path: polygon(50% 50%, 100% 50%, 100% 100%, 50% 100%); }

	.opening__solid-bb {
		position: absolute;
		left: 50%; top: 50%;
		width: clamp(5rem, 15vw, 8rem);
		height: clamp(5rem, 15vw, 8rem);
		margin: calc(clamp(5rem, 15vw, 8rem) / -2);
		color: var(--paper);
		opacity: 0;
		will-change: transform, opacity;
	}

	.opening__solid-bb svg { width: 100%; height: 100%; fill: currentColor; }

	.opening__meta {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-meta);
		opacity: 0;
		pointer-events: none;
	}

	.opening__meta-sub {
		color: var(--color-text-muted);
	}
</style>
