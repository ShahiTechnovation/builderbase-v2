---
/**
 * Link styled as an action. `primary` is the single indigo action on a
 * surface; `quiet` is a text action.
 */
import type { NavLink } from '../data/site';

interface Props {
	link: NavLink;
	variant?: 'primary' | 'quiet';
	class?: string;
}

const { link, variant = 'quiet', class: className } = Astro.props;
---

<a href={link.href} class:list={['action', `action--${variant}`, className]}>
	<span class="action__label">{link.label}</span>{link.arrow && <span class="action__arrow" aria-hidden="true">↗</span>}
</a>

<style>
	.action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35em;
		min-height: 2.75rem; /* 44px touch target */
		font-size: var(--text-action);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-ui);
		line-height: 1;
		white-space: nowrap;
	}

	/* Primary: a darker fill sweeps in from the left. */
	.action--primary {
		min-height: 3.25rem; /* 52px */
		padding-inline: 1.75rem;
		background:
			linear-gradient(var(--color-accent-hover), var(--color-accent-hover)) no-repeat left / 0% 100%,
			var(--color-accent);
		color: var(--color-on-accent);
		border-radius: var(--radius-sm);
		transition: background-size var(--duration-base) var(--ease-editorial);
	}

	.action--primary:hover {
		background-size: 100% 100%;
	}

	/* Quiet: the underline draws in from the left. */
	.action--quiet {
		color: var(--color-text);
	}

	.action--quiet .action__label {
		padding-block: 0.3em;
		background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0% 1px;
		transition: background-size var(--duration-base) var(--ease-editorial);
	}

	.action--quiet:hover .action__label {
		background-size: 100% 1px;
	}

	/* The arrow leans toward where it leads. */
	.action__arrow {
		font-size: 0.875em;
		transition: translate var(--duration-base) var(--ease-editorial);
	}

	.action:hover .action__arrow {
		translate: 3px -3px;
	}
</style>
