---
import { Font } from 'astro:assets';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHomepageContent } from '../data/content';
import type { ResolvedPhoto } from '../data/model';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** Social card photo. Defaults to the curated hero photograph. */
	ogPhoto?: ResolvedPhoto;
}

const { title, description, noindex } = Astro.props;
const ogPhoto = Astro.props.ogPhoto ?? (await getHomepageContent()).heroPhoto;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Set before first paint: `js` enables progressive behaviour; `motion`
			// enables animation only when reduced motion is not requested.
			(function (root) {
				root.classList.add('js');
				if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) root.classList.add('motion');
			})(document.documentElement);
		</script>
		<Font cssVariable="--font-schibsted-grotesk" preload />
		<Font cssVariable="--font-fragment-mono" />
		<SeoHead title={title} description={description} noindex={noindex} ogPhoto={ogPhoto} />
		<meta name="theme-color" content={site.themeColor} />
		<meta name="color-scheme" content="light" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main" tabindex="-1">
			<slot />
		</main>
	</body>
</html>

<script>
	import '../scripts/motion';
</script>

<style>
	main:focus {
		outline: none;
	}
</style>
