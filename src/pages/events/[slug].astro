---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEventBySlug, getAllEvents } from '../../data/content';
import { whenLabel } from '../../lib/luma/events';
import { buildEventSchema, buildBreadcrumbSchema } from '../../lib/seo/schema';
import EventCard from '../../components/events/EventCard.astro';
import { destinations } from '../../data/site';

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/events');
}

const event = await getEventBySlug(slug);
if (!event) {
	Astro.response.status = 404;
	Astro.response.statusText = 'Not Found';
}

const allEvents = event ? await getAllEvents() : [];
const isUpcoming = event ? Date.parse(event.startsAt) > Date.now() : false;

// Find related events (same city or upcoming)
const relatedEvents = event
	? allEvents
			.filter((e) => e.id !== event.id && (e.city === event.city || (!event.city && e.online === event.online)))
			.slice(0, 3)
	: [];

// Format date and time
const formattedWhen = event ? whenLabel(event, true) : '';
const whereLabel = event ? (event.online ? 'Online Event' : event.city ? `${event.city}, India` : 'India') : '';

// Determine relationship label
let involvementLabel = 'CURATED EVENT';
if (event?.hostedByBuilderBase) {
	involvementLabel = 'HOSTED BY BUILDER BASE';
} else if (event?.hostName) {
	involvementLabel = `COMMUNITY PARTNER · ${event.hostName.toUpperCase()}`;
}

const pageTitle = event ? `${event.title} — Builder Base Events` : 'Event Not Found — Builder Base';
const pageDescription = event
	? `${event.title} in ${whereLabel} on ${formattedWhen}. ${involvementLabel}. Details, schedule, and verified registration via Builder Base.`
	: 'The requested event could not be found on Builder Base. Browse all upcoming and past developer rooms.';

// Structured data
const jsonLd = event
	? [
			buildEventSchema({
				id: event.id,
				title: event.title,
				description: pageDescription,
				url: event.url,
				startsAt: event.startsAt,
				endsAt: event.endsAt,
				timezone: event.timezone,
				city: event.city,
				venueName: whereLabel,
				online: event.online,
				coverUrl: event.coverUrl,
				organizerName: event.hostedByBuilderBase ? 'Builder Base' : event.hostName || 'Builder Base Community',
				status: 'scheduled',
			}),
			buildBreadcrumbSchema([
				{ name: 'Home', url: '/' },
				{ name: 'Events', url: '/events' },
				{ name: event.title, url: `/events/${slug}` },
			]),
		]
	: undefined;
---

{
	!event ? (
		<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>
			<article class="event-detail page-width" style="padding-top: var(--space-8); padding-bottom: var(--space-10);">
				<nav class="breadcrumb meta" aria-label="Breadcrumb">
					<ol class="breadcrumb__list">
						<li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Home</a></li>
						<li class="breadcrumb__separator" aria-hidden="true">/</li>
						<li class="breadcrumb__item"><a href="/events" class="breadcrumb__link">Events</a></li>
						<li class="breadcrumb__separator" aria-hidden="true">/</li>
						<li class="breadcrumb__item breadcrumb__item--current" aria-current="page">Not Found</li>
					</ol>
				</nav>
				<header class="event-detail__header" style="border-bottom: none;">
					<div class="event-detail__topbar meta">
						<span class="event-detail__badge">404 /// EVENT NOT FOUND</span>
					</div>
					<h1 class="event-detail__title">This room could not be found.</h1>
					<p style="font-size: var(--text-body); color: var(--color-text-muted); margin-bottom: var(--space-6); max-width: 60ch;">
						The event may have been rescheduled, unlisted, or moved. Explore all upcoming and historical gatherings across the Builder Base network.
					</p>
					<a href="/events" class="action action--primary">
						<span class="action__label">Browse All Events</span>
						<span class="action__arrow" aria-hidden="true">→</span>
					</a>
				</header>
			</article>
		</BaseLayout>
	) : (
		<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
			<article class="event-detail page-width">
				{/* BREADCRUMBS */}
				<nav class="breadcrumb meta" aria-label="Breadcrumb">
					<ol class="breadcrumb__list">
						<li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Home</a></li>
						<li class="breadcrumb__separator" aria-hidden="true">/</li>
						<li class="breadcrumb__item"><a href="/events" class="breadcrumb__link">Events</a></li>
						<li class="breadcrumb__separator" aria-hidden="true">/</li>
						<li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{event.title}</li>
					</ol>
				</nav>

				{/* HEADER */}
				<header class="event-detail__header">
					<div class="event-detail__topbar meta">
						<span class="event-detail__badge">{involvementLabel}</span>
						<span class="event-detail__status-indicator">
							{isUpcoming ? '● UPCOMING EVENT' : 'ARCHIVED ROOM'}
						</span>
					</div>

					<h1 class="event-detail__title">{event.title}</h1>

					<div class="event-detail__keyfacts">
						<div class="keyfact">
							<span class="keyfact__label meta">DATE & TIME</span>
							<time class="keyfact__val" datetime={event.startsAt}>{formattedWhen}</time>
							<span class="keyfact__sub meta">Timezone: {event.timezone || 'Asia/Kolkata'}</span>
						</div>

						<div class="keyfact">
							<span class="keyfact__label meta">LOCATION</span>
							<span class="keyfact__val">{whereLabel}</span>
							<span class="keyfact__sub meta">{event.online ? 'Virtual access' : 'In-person room'}</span>
						</div>

						<div class="keyfact">
							<span class="keyfact__label meta">NETWORK ROLE</span>
							<span class="keyfact__val">{event.hostedByBuilderBase ? 'Builder Base Node' : (event.hostName || 'Ecosystem Partner')}</span>
							<span class="keyfact__sub meta">Verified calendar record</span>
						</div>
					</div>
				</header>

				{/* MEDIA & REGISTRATION */}
				<div class="event-detail__hero-grid">
					<div class="event-detail__media-frame">
						{
							event.coverUrl ? (
								<img
									src={event.coverUrl}
									alt={`${event.title} cover`}
									class="event-detail__cover"
									loading="eager"
									decoding="async"
								/>
							) : (
								<div class="event-detail__placeholder">
									<span class="meta">BUILDER BASE ROOM</span>
								</div>
							)
						}
					</div>

					<aside class="event-detail__action-card">
						<div class="action-card__inner">
							<h2 class="action-card__heading meta">REGISTRATION & ACCESS</h2>
							<p class="action-card__desc">
								{isUpcoming
									? 'Access passes and RSVPs are managed through the official Builder Base calendar on Luma.'
									: 'This room has completed. Browse historical details or connect with builders on the network.'}
							</p>

							<div class="action-card__actions">
								<a
									href={event.url}
									target="_blank"
									rel="noopener noreferrer"
									class="action action--primary action-card__btn"
								>
									<span class="action__label">{isUpcoming ? 'Register on Luma' : 'View Luma Record'}</span>
									<span class="action__arrow" aria-hidden="true">↗</span>
								</a>

								<a
									href={destinations.lumaCalendar}
									target="_blank"
									rel="noopener noreferrer"
									class="action action--quiet action-card__btn"
								>
									<span class="action__label">Follow Calendar</span>
									<span class="action__arrow" aria-hidden="true">↗</span>
								</a>
							</div>

							<div class="action-card__guarantee meta">
								<span>✓ OFFICIAL EVENT RECORD</span>
								<span>✓ VERIFIED REGISTRATION ACCESS</span>
							</div>
						</div>
					</aside>
				</div>

				{/* RELATED EVENTS */}
				{
					relatedEvents.length > 0 && (
						<section class="event-detail__related" aria-labelledby="related-heading">
							<div class="related__topbar meta">
								<span id="related-heading">MORE ROOMS & GATHERINGS</span>
								<a href="/events" class="related__all-link">View all events →</a>
							</div>
							<div class="related__grid">
								{relatedEvents.map((e) => (
									<EventCard event={e} upcoming={Date.parse(e.startsAt) > Date.now()} />
								))}
							</div>
						</section>
					)
				}
			</article>
		</BaseLayout>
	)
}

<style>
	.event-detail {
		padding-top: var(--space-6);
		padding-bottom: var(--space-10);
	}

	.breadcrumb {
		margin-bottom: var(--space-6);
	}

	.breadcrumb__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.breadcrumb__link {
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.breadcrumb__link:hover {
		color: var(--color-text);
	}

	.breadcrumb__separator {
		color: var(--color-rule);
	}

	.breadcrumb__item--current {
		color: var(--color-text);
		max-width: 40ch;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Header */
	.event-detail__header {
		border-bottom: 1px solid var(--color-rule);
		padding-bottom: var(--space-6);
		margin-bottom: var(--space-6);
	}

	.event-detail__topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-3);
	}

	.event-detail__badge {
		background: var(--paper-200);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		letter-spacing: var(--tracking-meta);
	}

	.event-detail__status-indicator {
		color: var(--builder-indigo);
		font-weight: var(--weight-medium);
	}

	.event-detail__title {
		font-family: var(--font-sans);
		font-size: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);
		font-weight: var(--weight-display);
		letter-spacing: var(--tracking-display);
		line-height: var(--leading-display);
		color: var(--color-text);
		margin: 0 0 var(--space-6) 0;
	}

	.event-detail__keyfacts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-5);
		padding-top: var(--space-4);
		border-top: 1px dashed var(--color-rule);
	}

	.keyfact {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.keyfact__label {
		color: var(--color-text-muted);
	}

	.keyfact__val {
		font-family: var(--font-sans);
		font-size: var(--text-body);
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}

	.keyfact__sub {
		color: var(--color-text-muted);
		font-size: 0.8rem;
	}

	/* Hero Grid */
	.event-detail__hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		margin-bottom: var(--space-10);
	}

	@media (min-width: 900px) {
		.event-detail__hero-grid {
			grid-template-columns: 2fr 1fr;
		}
	}

	.event-detail__media-frame {
		background: var(--paper-200);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-frame);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 320px;
		max-height: 520px;
	}

	.event-detail__cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.event-detail__placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 300px;
		color: var(--color-text-muted);
	}

	.event-detail__action-card {
		background: var(--color-bg);
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-frame);
		padding: var(--space-6);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.action-card__heading {
		color: var(--color-text-muted);
		margin-bottom: var(--space-3);
	}

	.action-card__desc {
		font-size: var(--text-body);
		line-height: var(--leading-body);
		color: var(--color-text);
		margin-bottom: var(--space-6);
	}

	.action-card__actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}

	.action-card__btn {
		width: 100%;
		justify-content: center;
	}

	.action-card__guarantee {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-rule);
		color: var(--color-text-muted);
		font-size: 0.75rem;
	}

	/* Related */
	.event-detail__related {
		border-top: 1px solid var(--color-rule);
		padding-top: var(--space-8);
	}

	.related__topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-6);
		color: var(--color-text-muted);
	}

	.related__all-link {
		color: var(--builder-indigo);
		text-decoration: none;
	}

	.related__all-link:hover {
		text-decoration: underline;
	}

	.related__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-6);
	}
</style>
