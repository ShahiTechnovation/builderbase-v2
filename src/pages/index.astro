---
import CultureGallery from '../components/CultureGallery.astro';
import Hero from '../components/Hero.astro';
import NextRooms from '../components/NextRooms.astro';
import OpeningHead from '../components/OpeningHead.astro';
import OpeningSequence from '../components/OpeningSequence.astro';
import Proof from '../components/Proof.astro';
import EcosystemBridge from '../components/EcosystemBridge.astro';
import PartnerConversion from '../components/PartnerConversion.astro';
import BuilderClosing from '../components/BuilderClosing.astro';
import { getHomepageContent } from '../data/content';
import { home } from '../data/home';
import { actions, destinations } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const content = await getHomepageContent();
const hasCulture = content.culturePhotos.length > 0;
---

<BaseLayout ogPhoto={content.heroPhoto}>
	<OpeningHead slot="head" />
	<OpeningSequence />
	<Hero
		statement={home.hero.statement}
		meta={home.hero.geography.approved ? home.hero.geography.text : undefined}
		photo={content.heroPhoto}
	/>
	{
		hasCulture && (
			<CultureGallery
				title={home.culture.title}
				galleryLabel={home.culture.galleryLabel}
				photos={content.culturePhotos}
			/>
		)
	}
	<Proof title={home.proof.title} items={home.proof.items} />
	<EcosystemBridge title={home.ecosystemBridge.title} description={home.ecosystemBridge.description} />
	<NextRooms
		marker={home.nextRooms.marker}
		title={home.nextRooms.title}
		note={home.nextRooms.note}
		action={actions.fullCalendar}
		calendar={{
			src: destinations.lumaCalendarEmbed,
			title: home.nextRooms.calendarTitle,
			loadingLabel: home.nextRooms.loadingLabel,
		}}
	/>
	<PartnerConversion title={home.partnerConversion.title} />
	<BuilderClosing title={home.builderClosing.title} marqueeText={home.builderClosing.marquee} />
</BaseLayout>
